{
  "_comment": "Endurance Plan - Hooks Configuration Template. Merge into ~/.claude/settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/safety-guard.py",
            "_comment": "Block dangerous commands (rm -rf /, force push, etc.)"
          },
          {
            "type": "command",
            "command": "python ~/.claude/hooks/filter-test-output.py",
            "_comment": "Filter test output to failures + summary only"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/compress-input.py",
            "_comment": "LLMLingua-2 input compression for large files (optional, requires: pip install llmlingua)"
          }
        ]
      }
    ]
  }
}
